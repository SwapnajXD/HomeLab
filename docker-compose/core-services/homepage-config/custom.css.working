:root {
--card-radius: 22px;
--glass-bg: rgba(255,255,255,.04);
--glass-border: rgba(255,255,255,.08);
--glass-hover: rgba(255,255,255,.12);
--panel-bg: rgba(15,23,42,.92);
}

/* ===================================== */
/* GLOBAL                                */
/* ===================================== */

body {
background:
radial-gradient(
circle at top left,
rgba(59,130,246,.18),
transparent 35%
),
radial-gradient(
circle at top right,
rgba(139,92,246,.14),
transparent 30%
),
linear-gradient(
180deg,
#111827 0%,
#0f172a 100%
) !important;
}

.service-card,
.bookmark {
border-radius: var(--card-radius);
border: 1px solid rgba(255,255,255,.06);
transition: .2s ease;
}

.service-card:hover,
.bookmark:hover {
transform: translateY(-3px);
}

h2 {
font-weight: 700;
letter-spacing: .08em;
}

::-webkit-scrollbar {
width: 10px;
}

::-webkit-scrollbar-thumb {
background: rgba(255,255,255,.15);
border-radius: 10px;
}

/* ===================================== */
/* OLYMPUS COMMAND CENTER                */
/* ===================================== */

#olympus-hero {

display: grid;

grid-template-columns:
280px
minmax(500px, 1fr)
280px;

gap: 24px;

padding: 28px;

border-radius: 30px;

background:
linear-gradient(
135deg,
rgba(30,41,59,.96),
rgba(15,23,42,.98)
);

border: 1px solid rgba(255,255,255,.08);

backdrop-filter: blur(24px);
}

/* ===================================== */
/* LEFT + RIGHT RAILS                    */
/* ===================================== */

.olympus-rail {
display: flex;
flex-direction: column;
gap: 18px;
}

.olympus-widget {

background: var(--glass-bg);

border: 1px solid var(--glass-border);

border-radius: 22px;

padding: 18px;

transition: .2s ease;

min-height: 120px;
}

.olympus-widget:hover {

transform: translateY(-3px);

border-color: var(--glass-hover);
}

.widget-title {

font-size: .95rem;

font-weight: 700;

letter-spacing: .04em;

margin-bottom: 14px;

opacity: .85;
}

.main-text {

font-size: 1.15rem;

font-weight: 700;

line-height: 1.3;
}

.sub-text {

margin-top: 6px;

opacity: .8;
}

.tiny-text {

margin-top: 6px;

opacity: .55;

font-size: .85rem;
}

/* ===================================== */
/* CENTER PANEL                          */
/* ===================================== */

.media-panel {

position: relative;

overflow: hidden;

border-radius: 28px;

min-height: 700px;

background:
linear-gradient(
180deg,
rgba(255,255,255,.03),
rgba(255,255,255,.01)
);

border: 1px solid rgba(255,255,255,.08);
}

.media-image,
.media-video {

width: 100%;

height: 100%;

object-fit: contain;

display: block;

padding: 40px;
}

.media-overlay {

position: absolute;

left: 0;
right: 0;
bottom: 0;

padding: 40px;

background:
linear-gradient(
to top,
rgba(0,0,0,.75),
rgba(0,0,0,.3),
transparent
);
}

.media-title {

font-size: 3rem;

font-weight: 800;

line-height: 1;
}

.media-subtitle {

margin-top: 10px;

font-size: 1.1rem;

opacity: .85;
}

/* ===================================== */
/* MUSIC CARD                            */
/* ===================================== */

.music-widget {

display: flex;

gap: 14px;
}

.album-cover {

width: 72px;

height: 72px;

border-radius: 14px;

object-fit: cover;

flex-shrink: 0;
}

/* ===================================== */
/* STATUS CHIP                           */
/* ===================================== */

.status-chip {

display: inline-flex;

align-items: center;

padding: 6px 12px;

border-radius: 999px;

font-size: .75rem;

font-weight: 600;

background: rgba(59,130,246,.18);

border: 1px solid rgba(59,130,246,.35);
}

/* ===================================== */
/* RESPONSIVE                            */
/* ===================================== */

@media (max-width: 1500px) {

#olympus-hero {

grid-template-columns:
  240px
  minmax(350px,1fr)
  240px;

}
}

@media (max-width: 1100px) {

#olympus-hero {

grid-template-columns: 1fr;

gap: 20px;

}

.media-panel {

min-height: 500px;

}

.olympus-rail {

display: grid;

grid-template-columns:
  repeat(2, 1fr);

gap: 16px;

}
}

@media (max-width: 700px) {

.olympus-rail {

grid-template-columns: 1fr;

}

.media-title {

font-size: 2rem;

}

.media-panel {

min-height: 350px;

}
}

