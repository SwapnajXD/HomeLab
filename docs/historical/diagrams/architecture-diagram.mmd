graph TD

    %% Remote Administration
    Artemis["Artemis<br/>Arch Linux Workstation"]
    Tailnet(("Tailscale Mesh VPN<br/>4 nodes"))

    Artemis -->|Remote Administration| Tailnet

    %% Infrastructure
    Tailnet --> Apollo
    Tailnet --> Athena

    subgraph Apollo["Apollo - Proxmox VE 9.2.2 Hypervisor"]
        direction TB

        Bridge["vmbr0<br/>Virtual Bridge"]

        subgraph Athena["Athena - Ubuntu VM"]
            direction TB

            subgraph Telemetry["Telemetry Stack"]
                Grafana["Grafana"]
                Prometheus["Prometheus"]
                Loki["Loki"]
                Alloy["Grafana Alloy"]
                NodeExporter["Node Exporter"]
                ProxmoxExporter["Proxmox Exporter"]
                Cadvisor["cAdvisor"]
                Glances["Glances"]
            end

            subgraph Kubernetes["Kubernetes Lab (no Ingress deployed)"]
                K3s["K3s Control Plane + Node"]
                K8sPortainerAgent["Portainer Agent (in-cluster)"]
            end

            subgraph Development["Development Services"]
                Floci["Floci (AWS Emulation - on-demand)"]
                Portainer["Portainer (central)"]
            end
        end

        subgraph Hestia["Hestia - LXC (Tailscale-isolated)"]
            direction TB

            subgraph CoreServices["Core Services - stock config + visual theme"]
                Homepage["Homepage (stock + custom.css theme)"]
                Vaultwarden["Vaultwarden"]
            end

            subgraph HestiaObservability["Per-host Observability"]
                HestiaAlloy["Grafana Alloy"]
                HestiaNodeExporter["Node Exporter"]
                HestiaPortainerAgent["Portainer Agent"]
            end
        end

        Bridge --- Athena
        Bridge -->|DNAT / NAT| Hestia
    end

    HestiaAlloy -.forwards logs.-> Loki
    HestiaPortainerAgent -.managed by.-> Portainer

    classDef host fill:#0b5394,color:#ffffff,stroke:#ffffff,stroke-width:2px;
    classDef guest fill:#e69138,color:#ffffff,stroke:#ffffff,stroke-width:2px;
    classDef service fill:#3d85c6,color:#ffffff,stroke:#ffffff,stroke-width:1px;
    classDef k8s fill:#326ce5,color:#ffffff,stroke:#ffffff,stroke-width:1px;

    class Apollo host;
    class Athena,Hestia guest;
    class Grafana,Prometheus,Loki,Alloy,NodeExporter,ProxmoxExporter,Cadvisor,Glances,Floci,Portainer,Homepage,Vaultwarden,HestiaAlloy,HestiaNodeExporter service;
    class K3s,K8sPortainerAgent,HestiaPortainerAgent k8s;
